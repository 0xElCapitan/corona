  "method": "stratified_random_seqgrouped",
  "ratio": {
    "train": 0.7,
    "heldout": 0.3
  },
  "seed": "corona-cycle-003-heldout-v1",
  "prng": "deterministic SHA-256 keyed ordering — order_key(group) = sha256(seed + '|' + theatre + '|' + group_id) as lowercase hex, groups sorted ASCENDING by order_key; NO Math.random, NO Date-derived entropy. group_id = lexicographically-smallest member event_id (= earliest by ISO-date prefix).",
  "grouping_rule": {
    "description": "Per theatre: sort primary events by (event_time, event_id); chain consecutive events whose event_time gap <= 120 h (5 days) into one atomic sequence group; a group is assigned WHOLE to one side (no straddle). Records carry NO explicit NOAA active-region or storm-sequence identifier, so temporal adjacency is the available, reproducible proxy (documented limitation).",
    "gap_threshold_hours": 120,
    "robustness_note": "Inter-event gaps fall cleanly into <=2.94-day (70.7 h) clusters vs >=7.69-day (184.6 h) separations (T1) and a 1.63-day (39 h) pair vs >=11.75-day (282 h) (T2); the 120 h (5.0 d) cut sits in that natural gap, so the grouping is invariant to any threshold in (2.94 d, 7.69 d) for T1 and (1.63 d, 11.75 d) for T2 (the chosen 5.0 d cut is interior to both measured bands).",
    "anchor": "event_time"
  },
  "stratification": {
    "T1": "outcome_bucket_6class",
    "T2": "g_scale",
    "T4": "coarse_S1_vs_S2plus_OR_underpowered"
  },
  "stratification_method": "Per theatre, per-bucket held-out cap = round(0.30 * n_bucket); greedily place sequence groups (in seed-hash order) into held-out while no bucket exceeds its cap; remainder -> train. Atomic groups may cause minor under-fill, reported honestly (no re-roll, no cherry-pick).",
  "per_theatre_minimums": {
    "T1": 5,
    "T2": 5,
    "T4": "underpowered/absent — 0 records (S04 BLOCKED-PARTIAL, Option B); below any meaningful minimum; not split",
    "rationale": "A held-out side below ~5 events yields Brier estimates too noisy to be meaningful; this is a methodology floor, not a fit. T1/T2 (heldout=9 each) clear it; T4 (0 records) does not."
  },
